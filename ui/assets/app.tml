<?xml version="1.1" encoding="UTF-8"?>
<Component xmlns="urn:tml:v1" name="App">
	<Import src="./theme.tml"/>

	<Property name="session" type="string" default=""/>
	<Property name="tabs" type="record[]" default=""/>
	<Property name="actions" type="record[]" default=""/>

	<Property name="mode" type="string" default=""/>
	<Property name="dir" type="string" default=""/>
	<Property name="command" type="string" default=""/>
	<Property name="size" type="string" default=""/>
	<Property name="note" type="string" default=""/>

	<Property name="cpu" type="string" default=""/>
	<Property name="cpuHistory" type="string[]" default=""/>
	<Property name="mem" type="string" default=""/>
	<Property name="net" type="string" default=""/>
	<Property name="load" type="string" default=""/>
	<Property name="gpu" type="string" default=""/>
	<Property name="clock" type="string" default=""/>

	<Property name="menuOpen" type="bool" default="false"/>
	<Property name="menuTitle" type="string" default=""/>
	<Property name="menuX" type="int" default="0"/>
	<Property name="menuY" type="int" default="0"/>
	<Property name="menu" type="record[]" default=""/>

	<Property name="promptOpen" type="bool" default="false"/>
	<Property name="promptTitle" type="string" default=""/>
	<Property name="promptValue" type="string" default=""/>
	<Property name="promptCursor" type="int" default="0"/>

	<Property name="helpOpen" type="bool" default="false"/>
	<Property name="help" type="record[]" default=""/>

	<!-- One clickable cell of a bar: a window tab, or a button. -->
	<DataTemplate name="Chip">
		<Property name="id" type="string" required="true"/>
		<Property name="action" type="string" required="true"/>
		<Property name="label" type="string" required="true"/>
		<Property name="look" type="string" required="true"/>
		<Template>
			<Box id="{id}" action="{action}" style="{look}">
				<Text overflow="clip">{label}</Text>
			</Box>
		</Template>
	</DataTemplate>

	<DataTemplate name="MenuItem">
		<Property name="id" type="string" required="true"/>
		<Property name="action" type="string" required="true"/>
		<Property name="label" type="string" required="true"/>
		<Property name="look" type="string" required="true"/>
		<Template>
			<Box id="{id}" action="{action}" style="{look}" width="*">
				<Text overflow="clip">{label}</Text>
			</Box>
		</Template>
	</DataTemplate>

	<DataTemplate name="HelpLine">
		<Property name="key" type="string" required="true"/>
		<Property name="what" type="string" required="true"/>
		<Template>
			<Grid columns="14,*" gap="1">
				<Text Grid.column="0" style="key" overflow="clip">{key}</Text>
				<Text Grid.column="1" overflow="clip">{what}</Text>
			</Grid>
		</Template>
	</DataTemplate>

	<Template>
		<Canvas>
			<Grid id="screen" columns="*" rows="*,1,1">
				<Panes id="panes" Grid.row="0"/>

				<Stack id="bar-windows" Grid.row="1" orientation="horizontal" style="bar">
					<Box id="session" action="sessions" style="chip.session">
						<Text overflow="clip">{session}</Text>
					</Box>
					<Stack id="tabs" orientation="horizontal" itemsSource="{tabs}" itemTemplate="Chip"/>
					<Spacer width="*"/>
					<Stack id="actions" orientation="horizontal" itemsSource="{actions}" itemTemplate="Chip"/>
				</Stack>

				<Stack id="bar-info" Grid.row="2" orientation="horizontal" style="bar">
					<Box id="mode" style="chip.mode" if="{mode}">
						<Text overflow="clip">{mode}</Text>
					</Box>
					<Box id="dir" action="copy-dir" style="chip" if="{dir}">
						<Text overflow="path">{dir}</Text>
					</Box>
					<Box id="command" style="chip" if="{command}">
						<Text style="dim" overflow="clip">{command}</Text>
					</Box>
					<Box id="size" style="chip" if="{size}">
						<Text style="dim" overflow="clip">{size}</Text>
					</Box>
					<Box id="note" style="chip.note" if="{note}">
						<Text overflow="clip">{note}</Text>
					</Box>
					<Spacer width="*"/>
					<Stack id="stat-cpu" action="stats" orientation="horizontal" gap="1" style="chip" if="{cpu}">
						<Text style="dim">CPU</Text>
						<Sparkline values="{cpuHistory}" max="100" color="{theme.accent}"/>
						<Text overflow="clip">{cpu}</Text>
					</Stack>
					<Stack id="stat-mem" action="stats" orientation="horizontal" gap="1" style="chip" if="{mem}">
						<Text style="dim">MEM</Text>
						<Text overflow="clip">{mem}</Text>
					</Stack>
					<Stack id="stat-gpu" action="stats" orientation="horizontal" gap="1" style="chip" if="{gpu}">
						<Text style="dim">GPU</Text>
						<Text overflow="clip">{gpu}</Text>
					</Stack>
					<Stack id="stat-net" action="stats" orientation="horizontal" gap="1" style="chip" if="{net}">
						<Text style="dim">NET</Text>
						<Text overflow="clip">{net}</Text>
					</Stack>
					<Stack id="stat-load" action="stats" orientation="horizontal" gap="1" style="chip" if="{load}">
						<Text style="dim">LOAD</Text>
						<Text overflow="clip">{load}</Text>
					</Stack>
					<Box id="clock" action="clock" style="chip" if="{clock}">
						<Text overflow="clip">{clock}</Text>
					</Box>
				</Stack>
			</Grid>

			<Border id="menu" kind="rounded" title="{menuTitle}" style="menu" if="{menuOpen}"
				Canvas.x="{menuX}" Canvas.y="{menuY}">
				<Stack id="menu-items" itemsSource="{menu}" itemTemplate="MenuItem"/>
			</Border>

			<Popup id="prompt" title="{promptTitle}" style="menu" width="44" if="{promptOpen}">
				<Stack gap="1">
					<Textbox id="prompt-input" action="prompt" value="{promptValue}" cursor="{promptCursor}" width="*"/>
					<Text style="dim">enter accepts, esc cancels</Text>
				</Stack>
			</Popup>

			<Popup id="help" title="gmux keys" style="menu" width="64" if="{helpOpen}">
				<Stack>
					<Stack itemsSource="{help}" itemTemplate="HelpLine"/>
					<Text style="dim">any key closes this</Text>
				</Stack>
			</Popup>
		</Canvas>
	</Template>
</Component>

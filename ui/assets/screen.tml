<?xml version="1.1" encoding="UTF-8"?>
<Component xmlns="urn:tml:v1" name="Screen">
	<Import src="./theme.tml"/>

	<Property name="session" type="string" default=""/>
	<Property name="tabs" type="record[]" default=""/>
	<Property name="actions" type="record[]" default=""/>

	<Property name="infoColumns" type="string" default="auto,*,auto,auto,auto,*,auto,auto,auto,auto,auto"/>
	<Property name="mode" type="string" default=""/>
	<Property name="dir" type="string" default=""/>
	<Property name="command" type="string" default=""/>
	<Property name="size" type="string" default=""/>
	<Property name="note" type="string" default=""/>

	<Property name="cpu" type="string" default=""/>
	<Property name="cpuHistory" type="string[]" default=""/>
	<Property name="mem" type="string" default=""/>
	<Property name="net" type="string" default=""/>
	<Property name="gpu" type="string" default=""/>
	<Property name="statsOpen" type="bool" default="false"/>
	<Property name="statsWidth" type="int" default="64"/>
	<Property name="statRows" type="record[]" default=""/>
	<Property name="clock" type="string" default=""/>

	<Property name="menuLook" type="string" default="chip"/>
	<Property name="menuOpen" type="bool" default="false"/>
	<Property name="menuTitle" type="string" default=""/>
	<Property name="menuX" type="int" default="0"/>
	<Property name="menuY" type="int" default="0"/>
	<Property name="menuItems" type="string[]" default=""/>
	<Property name="menuSelected" type="int" default="-1"/>

	<Property name="promptOpen" type="bool" default="false"/>
	<Property name="promptTitle" type="string" default=""/>
	<Property name="promptValue" type="string" default=""/>
	<Property name="promptCursor" type="int" default="0"/>

	<Property name="helpOpen" type="bool" default="false"/>
	<Property name="help" type="record[]" default=""/>

	<!-- One clickable cell of the window row: a button, or a window tab with the cell that closes its window. Hit is
	     what makes each answer the pointer. A cell with no close action has no close cell. -->
	<DataTemplate name="Chip">
		<Property name="id" type="string" required="true"/>
		<Property name="action" type="string" required="true"/>
		<Property name="label" type="string" required="true"/>
		<Property name="look" type="string" required="true"/>
		<Property name="tip" type="string" default=""/>
		<Property name="closeId" type="string" default=""/>
		<Property name="closeAction" type="string" default=""/>
		<Property name="closeLook" type="string" default="close"/>
		<Property name="closeTip" type="string" default=""/>
		<Property name="mark" type="string" default=""/>
		<Property name="blank" type="bool" default="false"/>
		<Template>
			<Hit id="{id}" action="{action}" style="{look}" tooltip="{tip}">
				<Stack orientation="horizontal">
					<Text overflow="clip">{label}</Text>
					<!-- The cell before the close cell holds the tab's mark, so a mark never moves the close cell. -->
					<Text if="{mark}">{mark}</Text>
					<Spacer width="1" if="{blank}"/>
					<Hit id="{closeId}" action="{closeAction}" style="{closeLook}" tooltip="{closeTip}" if="{closeAction}">
						<Text>×</Text>
					</Hit>
				</Stack>
			</Hit>
		</Template>
	</DataTemplate>

	<!-- One reading of the detail view of the host: its name, a graph of its recent values, and the value in words. -->
	<DataTemplate name="StatRow">
		<Property name="label" type="string" required="true"/>
		<Property name="values" type="string[]" default=""/>
		<Property name="max" type="string" default="0"/>
		<Property name="text" type="string" default=""/>
		<Template>
			<Grid columns="6,30,*" gap="1">
				<Text Grid.column="0" style="dim" overflow="clip">{label}</Text>
				<Sparkline Grid.column="1" values="{values}" max="{max}" color="{theme.accent}"/>
				<Text Grid.column="2" overflow="clip">{text}</Text>
			</Grid>
		</Template>
	</DataTemplate>

	<DataTemplate name="HelpLine">
		<Property name="key" type="string" required="true"/>
		<Property name="what" type="string" required="true"/>
		<Template>
			<Grid columns="20,*" gap="1">
				<Text Grid.column="0" style="key" overflow="clip">{key}</Text>
				<Text Grid.column="1" overflow="clip">{what}</Text>
			</Grid>
		</Template>
	</DataTemplate>

	<Template>
		<Canvas>
			<Grid id="screen" columns="*" rows="1,*,1">
				<!-- The window row is over the window: the menu, the session, a tab for each window, and what the
				     client itself does. A click here never goes to the program in a pane. -->
				<Hit id="bar-windows" Grid.row="0" style="bar">
					<Stack orientation="horizontal">
						<Hit id="main-menu" action="main-menu" style="{menuLook}"
							tooltip="Menu: split the window, zoom or close a pane, sessions, keys">
							<Text>≡</Text>
						</Hit>
						<Hit id="session" action="sessions" style="chip.session"
							tooltip="This session. Click for the list of sessions">
							<Text overflow="clip">{session}</Text>
						</Hit>
						<Stack orientation="horizontal" itemsSource="{tabs}" itemTemplate="Chip"/>
						<Spacer width="*"/>
						<Stack orientation="horizontal" itemsSource="{actions}" itemTemplate="Chip"/>
					</Stack>
				</Hit>

				<Panes id="panes" Grid.row="1"/>

				<!-- The columns give way in the order collapse names them, so a narrow terminal keeps the directory
				     and the clock longest. The directory's column is cut to the room there is. -->
				<Grid id="bar-info" Grid.row="2" style="bar" columns="{infoColumns}" collapse="9,8,3,2,7,6,10">
					<Box Grid.column="0" style="chip.mode" if="{mode}">
						<Text overflow="clip">{mode}</Text>
					</Box>
					<Hit id="dir" action="copy-dir" Grid.column="1" style="chip" if="{dir}"
						tooltip="The pane's directory. Click to copy it">
						<Text overflow="path">{dir}</Text>
					</Hit>
					<Box Grid.column="2" style="chip" if="{command}">
						<Text style="dim" overflow="clip">{command}</Text>
					</Box>
					<Box Grid.column="3" style="chip" if="{size}">
						<Text style="dim" overflow="clip">{size}</Text>
					</Box>
					<Box Grid.column="4" style="chip.note" if="{note}">
						<Text overflow="clip">{note}</Text>
					</Box>
					<Hit id="stat-cpu" action="stats" Grid.column="6" style="chip" if="{cpu}"
						tooltip="Processor use of the whole host. Click to show or hide the detail view">
						<Stack orientation="horizontal" gap="1">
							<Text style="dim">CPU</Text>
							<Sparkline values="{cpuHistory}" max="100" color="{theme.accent}"/>
							<Text overflow="clip">{cpu}</Text>
						</Stack>
					</Hit>
					<Hit id="stat-mem" action="stats" Grid.column="7" style="chip" if="{mem}"
						tooltip="Memory in use. Click to show or hide the detail view">
						<Stack orientation="horizontal" gap="1">
							<Text style="dim">MEM</Text>
							<Text overflow="clip">{mem}</Text>
						</Stack>
					</Hit>
					<Hit id="stat-gpu" action="stats" Grid.column="8" style="chip" if="{gpu}"
						tooltip="Graphics processor use. Click to show or hide the detail view">
						<Stack orientation="horizontal" gap="1">
							<Text style="dim">GPU</Text>
							<Text overflow="clip">{gpu}</Text>
						</Stack>
					</Hit>
					<Hit id="stat-net" action="stats" Grid.column="9" style="chip" if="{net}"
						tooltip="Network traffic, down and up. Click to show or hide the detail view">
						<Stack orientation="horizontal" gap="1">
							<Text style="dim">NET</Text>
							<Text overflow="clip">{net}</Text>
						</Stack>
					</Hit>
					<Hit id="clock" action="clock" Grid.column="10" style="chip" if="{clock}"
						tooltip="Click to show the date">
						<Text overflow="clip">{clock}</Text>
					</Hit>
				</Grid>
			</Grid>

			<!-- The detail view of the host stands over the window, in the corner over the readings. It takes no key. -->
			<Popup id="stats-box" title="host" style="menu" width="{statsWidth}" if="{statsOpen}"
				Canvas.anchor="bottomRight" Canvas.x="0" Canvas.y="-1">
				<Stack itemsSource="{statRows}" itemTemplate="StatRow"/>
			</Popup>

			<Menu id="menu" action="menu" title="{menuTitle}" items="{menuItems}" selected="{menuSelected}"
				accent="{theme.accent}" accentText="{theme.accentText}" style="menu" if="{menuOpen}"
				Canvas.x="{menuX}" Canvas.y="{menuY}"/>

			<Popup id="prompt" title="{promptTitle}" style="menu" width="44" if="{promptOpen}">
				<Stack gap="1">
					<Textbox id="prompt-input" action="prompt" value="{promptValue}" cursor="{promptCursor}" width="*"/>
					<Text style="dim">enter accepts, esc cancels</Text>
				</Stack>
			</Popup>

			<Popup id="help-box" title="gmux keys" style="menu" width="64" if="{helpOpen}">
				<Stack>
					<Stack itemsSource="{help}" itemTemplate="HelpLine"/>
					<Text style="dim">any key closes this</Text>
				</Stack>
			</Popup>
		</Canvas>
	</Template>
</Component>
